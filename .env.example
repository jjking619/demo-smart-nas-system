# =============================================================================
# NAS-Demo 用户配置模板
# 只需填写前 3 项（OpenClaw 模型），其余已提供可用的默认值。
# 复制为 .env 后填写：cp .env.example .env
# =============================================================================

# ── 必填：OpenClaw 的 LLM 模型（OpenAI 兼容接口）───────────────────────────
# 任意 OpenAI 兼容的 base URL，例如：
#   https://api.deepseek.com/v1
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# 注意：不要以 /chat/completions 结尾，只写到 /v1 为止
OPENCLAW_MODEL_BASE_URL=https://api.deepseek.com/v1

# 你的模型 API key（只存在本地 .env，不进容器配置、不进 git）
OPENCLAW_MODEL_API_KEY=

# 模型 ID（可选，默认 deepseek-chat）
OPENCLAW_MODEL_ID=deepseek-chat

# ── 可选：网关访问 token（默认自动随机生成，无需修改）────────────────────
# OPENCLAW_GATEWAY_TOKEN=

# ── 以下为系统内部默认值，一般无需修改 ─────────────────────────────────────
# Immich 首次启动会自动初始化管理员并生成 API key（自动注入 OpenClaw），
# 无需手工填写。如需覆盖可在此设置：
# IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=

# 媒体下载 / 知识库服务地址（容器网络内部自动解析，无需修改）
DOWNLOAD_API_URL=http://media_downloader:8081/download
KB_API_URL=http://knowledge_base:8084
VOICE_SDK_BASE=/home/pi/voice

# ── 可选：语音桥参数（推荐在 .env 配置，命令行可覆盖）────────────────────
# [A] 麦克风路由（推荐保持默认）
# 优先 USB，USB 不可用时退回板载；同一时刻只使用一支麦克风。
# VOICE_MIC_PRIORITY=usb,onboard
# VOICE_MIC_USB_BACKEND=alsa
# VOICE_MIC_USB_INPUT=plughw:Audio,0
# VOICE_MIC_ONBOARD_BACKEND=pulse
# VOICE_MIC_ONBOARD_INPUT=regular0
# VOICE_MIC_RECHECK_SEC=60
# VOICE_MIC_STRICT=0
# VOICE_MIC_MIN_LEVEL_DBFS=-75

# [B] 录音后端与唤醒灵敏度（按需启用）
# VOICE_RECORD_BACKEND=auto
# VOICE_MIC_INPUT=default
# VOICE_WAKE_MIN_LEVEL_DBFS=-82.0
# VOICE_WAKE_LOW_LEVEL_DBFS=-58.0
# VOICE_WAKE_BOOST_DB=12.0

# [C] 异常退避（避免设备异常时高频空转）
# VOICE_HTTP_WAKE_ERROR_BACKOFF_INITIAL_SEC=1.0
# VOICE_HTTP_WAKE_ERROR_BACKOFF_MAX_SEC=30.0

# [C2] 低占用待机开关
# 0 = 关闭后台唤醒词常驻监听（CPU 立降，改用网页按钮/文本触发）
# VOICE_HTTP_WAKEWORD=0
# 0 = 不常驻 ASR/TTS 模型（降低内存占用，触发时会稍慢）
# VOICE_HTTP_KEEP_MODELS=0

# [D] 可选：参考的“稳健默认”参数（噪声大时可退回）
# VOICE_WAKE_MIN_LEVEL_DBFS=-75.0
# VOICE_WAKE_LOW_LEVEL_DBFS=-55.0
# VOICE_WAKE_BOOST_DB=6.0

# [E] 可选：ASR 增益高级参数（一般无需改）
# VOICE_ASR_GAIN_TARGET_DBFS=-20.0
# VOICE_ASR_MAX_GAIN_DB=40.0
# VOICE_ASR_PEAK_CEILING_DBFS=-1.0

# Jellyfin API 密钥（语音说“播放/下载后自动播放”需要）：
#   Jellyfin 管理后台 → 控制台 → 高级 → API 密钥 → 新增 API 密钥，
#   复制到下面并重启语音桥：sudo systemctl restart voice-bridge
JELLYFIN_API_KEY=

# ── 路径配置（install.sh 首次运行自动写入，无需手动改）──────────────────
# NAS 共享数据根目录（默认 = 当前用户主目录/nas_share，可改成任意路径）
# 脚本(oc.sh/install.sh)读取它；docker compose 挂载也用它。
NAS_ROOT=

# 项目代码目录（install.sh 运行时自动写为实际 clone 位置）
APP_DIR=

# 宿主运行用户 UID/GID（filebrowser 等以宿主用户身份读写 NAS）
NAS_PUID=
NAS_PGID=
