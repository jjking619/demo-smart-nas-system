{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "tls": {
      "enabled": true,
      "autoGenerate": true
    },
    "controlUi": {
      "allowedOrigins": ["*"]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "custom": {
        "baseUrl": "${OPENCLAW_MODEL_BASE_URL}",
        "apiKey": "${OPENCLAW_MODEL_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${OPENCLAW_MODEL_ID}",
            "name": "${OPENCLAW_MODEL_ID}",
            "input": ["text", "image"],
            "contextWindow": 64000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "custom/${OPENCLAW_MODEL_ID}"
      }
    }
  }
}
